# RentCast API — https://www.rentcast.io/api
# Powers property auto-populate (beds/baths/sqft/year built/estimated value/estimated rent).
RENTCAST_API_KEY=
# In-memory cap on outbound RentCast calls per server run (resets on restart) —
# a safety net while testing against a limited free-tier quota. Each property
# search makes 3 calls (record + value + rent), so the default of 50 is ~16 searches.
RENTCAST_MAX_REQUESTS=50

# Supabase — https://supabase.com
# Used for auth (email/password) and storing saved deals.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — https://console.anthropic.com
# Powers the AI investment recommendation. Never exposed to the client.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Stripe — https://dashboard.stripe.com/apikeys
# Free tier (3 lifetime analyses) needs no Stripe config at all. Starter/Investor
# subscriptions and the 10-analysis top-up need all four of these set.
# STRIPE_WEBHOOK_SECRET comes from the webhook endpoint's signing secret (or
# `stripe listen` for local dev).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_INVESTOR=
STRIPE_PRICE_TOPUP=

# Comma-separated emails that bypass the subscription paywall entirely
# (owner/admin access, no Stripe subscription needed).
ADMIN_EMAILS=

# Set to "false" to close the app to the public entirely — blocks new
# signups and blocks starting a Stripe checkout, while ADMIN_EMAILS
# accounts keep working. Defaults to open (any other value, or unset).
PUBLIC_ACCESS_ENABLED=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
