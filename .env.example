# RentCast API — https://www.rentcast.io/api
# Powers property auto-populate (beds/baths/sqft/year built/estimated value/estimated rent).
RENTCAST_API_KEY=
# In-memory cap on outbound RentCast calls per server run (resets on restart) —
# a safety net while testing against a limited free-tier quota. Each property
# search makes 3 calls (record + value + rent), so the default of 50 is ~16 searches.
RENTCAST_MAX_REQUESTS=50

# Supabase — https://supabase.com
# Used for auth (email/password) and storing saved deals.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — https://console.anthropic.com
# Powers the AI investment recommendation. Never exposed to the client.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
