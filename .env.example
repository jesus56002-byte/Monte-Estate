# RentCast API — https://www.rentcast.io/api
# Powers property auto-populate (beds/baths/sqft/year built/estimated value/estimated rent).
RENTCAST_API_KEY=

# Supabase — https://supabase.com
# Used for auth (email/password) and storing saved deals.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — https://console.anthropic.com
# Powers the AI investment recommendation. Never exposed to the client.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
