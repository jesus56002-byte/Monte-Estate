# RentCast API — https://www.rentcast.io/api
# Powers property auto-populate (beds/baths/sqft/year built/estimated value/estimated rent).
# No request cap here by design — RentCast bills overage per-call past your
# plan's included quota rather than hard-blocking, and abuse is bounded by the
# per-user cooldown in app/(app)/deals/actions.ts, not a global counter. Watch
# real usage/cost on the admin dashboard.
RENTCAST_API_KEY=

# Google Places API (New) — https://console.cloud.google.com
# Powers address-suggestion typeahead on the search bar via the autocomplete
# endpoint only (no Place Details call, so it's one billed session per search
# instead of two). Optional — the search bar works as a plain text field
# without it, just with no suggestions.
GOOGLE_PLACES_API_KEY=

# Supabase — https://supabase.com
# Used for auth (email/password) and storing saved deals.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — https://console.anthropic.com
# Powers the AI investment recommendation. Never exposed to the client.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Stripe — https://dashboard.stripe.com/apikeys
# Free tier (3 signup analyses) needs no Stripe config at all. Starter/Investor
# subscriptions, the in-plan top-up, and the standalone Pay As You Go purchase
# all need every one of these five set.
# STRIPE_WEBHOOK_SECRET comes from the webhook endpoint's signing secret (or
# `stripe listen` for local dev).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_INVESTOR=
# 10 analyses, $4.99 — for existing Starter/Investor subscribers only.
STRIPE_PRICE_TOPUP=
# 10 analyses, $9.99 — the no-subscription-required standalone option.
STRIPE_PRICE_PAYG=

# Comma-separated emails that bypass the subscription paywall entirely
# (owner/admin access, no Stripe subscription needed).
ADMIN_EMAILS=

# Set to "false" to close the app to the public entirely — blocks new
# signups and blocks starting a Stripe checkout, while ADMIN_EMAILS
# accounts keep working. Defaults to open (any other value, or unset).
PUBLIC_ACCESS_ENABLED=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
